rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function role() { return request.auth.token.role; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function isInstructorOf(courseId) {
      return role() == 'INS' &&
        get(/databases/$(database)/documents/courses/$(courseId)).data.instructorUid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || role() in ['ADM','INS']);
      allow write: if false; // 계정 생성/수정은 반드시 Cloud Functions(Admin SDK) 경유
    }

    match /courses/{courseId} {
      allow read: if isSignedIn();
      allow write: if role() == 'ADM';

      match /periods/{periodId} {
        allow read: if isSignedIn();
        allow write: if role() == 'ADM';
      }
    }

    match /attendance/{courseId}/{date}/{periodId}/records/{uid} {
      allow read: if isSignedIn() && (isOwner(uid) || isInstructorOf(courseId) || role() in ['ADM','APR']);

      // 교육생 셀프 체크(신청) — 최초 생성 및 확정 전 재신청
      allow create: if role() == 'STU' && isOwner(uid)
        && request.resource.data.status in ['pending', 'earlyLeaveRequested'];
      allow update: if role() == 'STU' && isOwner(uid)
        && resource.data.locked != true
        && request.resource.data.status in ['pending', 'earlyLeaveRequested'];

      // 담당 교관 또는 관리자 확정 — 미체크자(문서 없음) 결석 처리 생성 포함, 확정 전 문서 수정
      // (관리자는 교관이 부재중일 때 대신 확정할 수 있어야 하므로 모든 과정에 대해 허용)
      allow create: if isInstructorOf(courseId) || role() == 'ADM';
      allow update: if (isInstructorOf(courseId) || role() == 'ADM') && resource.data.locked != true;

      allow delete: if false;
    }

    match /corrections/{id} {
      allow create: if isSignedIn() && role() == 'STU' && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || role() in ['INS','ADM']);
      // 승인/반려는 반드시 decideCorrection Cloud Function(Admin SDK) 경유 — 잠긴 출결 레코드까지 함께 갱신해야 하기 때문
      allow update: if false;
    }

    match /reports/{id} {
      allow read: if role() in ['INS','ADM','APR'];
      allow write: if false; // 생성·상태변경은 전부 Cloud Functions
    }

    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create, delete: if false; // 생성은 Cloud Functions만
    }

    match /auditLogs/{id} {
      allow read: if role() == 'ADM';
      allow write: if false; // 오직 Admin SDK(Cloud Functions)만 기록
    }

    match /devices/{id} {
      allow read: if role() == 'ADM';
      allow write: if role() == 'ADM';
    }

    match /orgNotifications/{id} {
      allow read: if role() in ['INS','ADM'];
      allow write: if false; // 발송은 반드시 notifyOrg Cloud Function 경유
    }
  }
}
